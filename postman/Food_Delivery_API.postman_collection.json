{
  "info": {
    "name": "Food Delivery API",
    "description": "REST API documentation for the Food Delivery backend.\n\n**How to use:**\n1. Import this collection and the `Food_Delivery_Local.postman_environment.json` file.\n2. Select the **Food Delivery – Local** environment.\n3. Call **Auth → Login** (or **Register**) — the `token` variable is saved automatically.\n4. All protected requests will use that token via the collection-level Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:3000/api" },
    { "key": "token",          "value": "" },
    { "key": "restaurant_id",  "value": "" },
    { "key": "menu_item_id",   "value": "" },
    { "key": "order_id",       "value": "" },
    { "key": "delivery_id",    "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Register, login, and get the current user.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"customer\",\n  \"phone\": \"081234567890\",\n  \"address\": \"Jl. Sudirman No. 1, Jakarta\"\n}"
            },
            "description": "Create a new user account.\n\n**Roles:** `customer` (default), `restaurant_owner`, `admin`\n\nReturns a JWT `token` and basic user info. The test script saves the token automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const { token } = pm.response.json();",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token saved from Register');",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"64b1c2d3e4f5a6b7c8d9e0f1\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"role\": \"customer\"\n  }\n}"
            },
            {
              "name": "409 Email already in use",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"message\": \"Email already in use\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "description": "Authenticate with email and password. The test script saves the JWT token to `{{token}}` automatically — all subsequent protected requests will use it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const { token } = pm.response.json();",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token saved from Login');",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"64b1c2d3e4f5a6b7c8d9e0f1\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"role\": \"customer\"\n  }\n}"
            },
            {
              "name": "401 Invalid credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"message\": \"Invalid credentials\"\n}"
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] },
            "description": "Returns the profile of the currently authenticated user.\n\n**Auth required:** Bearer token"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"user\": {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f1\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"role\": \"customer\",\n    \"phone\": \"081234567890\",\n    \"address\": \"Jl. Sudirman No. 1, Jakarta\",\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"message\": \"No token, authorization denied\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Restaurants",
      "description": "Manage restaurants. Creating, updating, and deleting requires the `restaurant_owner` or `admin` role.",
      "item": [
        {
          "name": "Get All Restaurants",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants", "host": ["{{base_url}}"], "path": ["restaurants"] },
            "description": "Returns a list of all restaurants. **Public** — no auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.length > 0) {",
                  "        pm.collectionVariables.set('restaurant_id', data[0]._id);",
                  "        console.log('restaurant_id saved:', data[0]._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f2\",\n    \"name\": \"Warung Nasi Padang\",\n    \"owner\": { \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f1\", \"name\": \"John Doe\", \"email\": \"john@example.com\" },\n    \"description\": \"Authentic Padang cuisine\",\n    \"address\": \"Jl. Thamrin No. 5, Jakarta\",\n    \"cuisine\": [\"Indonesian\", \"Padang\"],\n    \"rating\": 4.5,\n    \"isOpen\": true,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get Restaurant by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/restaurants/{{restaurant_id}}", "host": ["{{base_url}}"], "path": ["restaurants", "{{restaurant_id}}"] },
            "description": "Returns a single restaurant by ID. **Public** — no auth required."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f2\",\n  \"name\": \"Warung Nasi Padang\",\n  \"owner\": { \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f1\", \"name\": \"John Doe\", \"email\": \"john@example.com\" },\n  \"description\": \"Authentic Padang cuisine\",\n  \"address\": \"Jl. Thamrin No. 5, Jakarta\",\n  \"cuisine\": [\"Indonesian\", \"Padang\"],\n  \"rating\": 4.5,\n  \"isOpen\": true\n}"
            },
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"message\": \"Restaurant not found\"\n}"
            }
          ]
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/restaurants", "host": ["{{base_url}}"], "path": ["restaurants"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warung Nasi Padang\",\n  \"description\": \"Authentic Padang cuisine\",\n  \"address\": \"Jl. Thamrin No. 5, Jakarta\",\n  \"cuisine\": [\"Indonesian\", \"Padang\"],\n  \"isOpen\": true\n}"
            },
            "description": "Create a new restaurant. The owner is set automatically from the authenticated user.\n\n**Auth required:** `restaurant_owner` or `admin` role"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('restaurant_id', data._id);",
                  "    console.log('restaurant_id saved:', data._id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f2\",\n  \"name\": \"Warung Nasi Padang\",\n  \"owner\": \"64b1c2d3e4f5a6b7c8d9e0f1\",\n  \"description\": \"Authentic Padang cuisine\",\n  \"address\": \"Jl. Thamrin No. 5, Jakarta\",\n  \"cuisine\": [\"Indonesian\", \"Padang\"],\n  \"rating\": 0,\n  \"isOpen\": true,\n  \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n}"
            },
            {
              "name": "403 Access denied",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"message\": \"Access denied\"\n}"
            }
          ]
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/restaurants/{{restaurant_id}}", "host": ["{{base_url}}"], "path": ["restaurants", "{{restaurant_id}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Warung Nasi Padang (Updated)\",\n  \"isOpen\": false\n}"
            },
            "description": "Update restaurant details. Only the restaurant owner or an admin can update.\n\n**Auth required:** `restaurant_owner` (owner only) or `admin`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f2\",\n  \"name\": \"Warung Nasi Padang (Updated)\",\n  \"isOpen\": false\n}"
            }
          ]
        },
        {
          "name": "Delete Restaurant",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/restaurants/{{restaurant_id}}", "host": ["{{base_url}}"], "path": ["restaurants", "{{restaurant_id}}"] },
            "description": "Delete a restaurant. Only the restaurant owner or an admin can delete.\n\n**Auth required:** `restaurant_owner` (owner only) or `admin`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"message\": \"Restaurant deleted\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Menu Items",
      "description": "Manage menu items per restaurant. Reading is public; creating/updating/deleting requires `restaurant_owner` or `admin`.",
      "item": [
        {
          "name": "Get Menu Items by Restaurant",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/menu-items/restaurant/{{restaurant_id}}", "host": ["{{base_url}}"], "path": ["menu-items", "restaurant", "{{restaurant_id}}"] },
            "description": "Returns all menu items for a specific restaurant. **Public** — no auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.length > 0) {",
                  "        pm.collectionVariables.set('menu_item_id', data[0]._id);",
                  "        console.log('menu_item_id saved:', data[0]._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f3\",\n    \"name\": \"Nasi Rendang\",\n    \"description\": \"Beef rendang with steamed rice\",\n    \"price\": 35000,\n    \"category\": \"Main Course\",\n    \"restaurant\": \"64b1c2d3e4f5a6b7c8d9e0f2\",\n    \"isAvailable\": true\n  }\n]"
            }
          ]
        },
        {
          "name": "Get Menu Item by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/menu-items/{{menu_item_id}}", "host": ["{{base_url}}"], "path": ["menu-items", "{{menu_item_id}}"] },
            "description": "Returns a single menu item by ID. **Public** — no auth required."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f3\",\n  \"name\": \"Nasi Rendang\",\n  \"description\": \"Beef rendang with steamed rice\",\n  \"price\": 35000,\n  \"category\": \"Main Course\",\n  \"restaurant\": { \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f2\", \"name\": \"Warung Nasi Padang\" },\n  \"isAvailable\": true\n}"

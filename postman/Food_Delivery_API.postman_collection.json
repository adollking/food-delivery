    {
      "name": "Orders",
      "description": "Place and manage orders.\n\n- `customer` — create orders, view their own orders\n- `restaurant_owner` — view and update status of orders for their restaurant\n- `admin` — full access",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/orders", "host": ["{{base_url}}"], "path": ["orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant\": \"{{restaurant_id}}\",\n  \"items\": [\n    { \"menuItem\": \"{{menu_item_id}}\", \"quantity\": 2 }\n  ],\n  \"deliveryAddress\": \"Jl. Gatot Subroto No. 10, Jakarta\",\n  \"note\": \"Extra spicy please\"\n}"
            },
            "description": "Place a new order. The `totalAmount` is calculated automatically from current menu item prices.\n\n**Auth required:** `customer` role\n\n**Status flow:** `pending` → `confirmed` → `preparing` → `delivering` → `delivered`\n(can be cancelled from `pending` or `confirmed`)"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('order_id', data._id);",
                  "    console.log('order_id saved:', data._id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n  \"customer\": \"64b1c2d3e4f5a6b7c8d9e0f1\",\n  \"restaurant\": \"64b1c2d3e4f5a6b7c8d9e0f2\",\n  \"items\": [\n    {\n      \"menuItem\": \"64b1c2d3e4f5a6b7c8d9e0f3\",\n      \"name\": \"Nasi Rendang\",\n      \"price\": 35000,\n      \"quantity\": 2\n    }\n  ],\n  \"status\": \"pending\",\n  \"totalAmount\": 70000,\n  \"deliveryAddress\": \"Jl. Gatot Subroto No. 10, Jakarta\",\n  \"note\": \"Extra spicy please\",\n  \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n}"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"message\": \"restaurant, items, and deliveryAddress are required\"\n}"
            }
          ]
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/my", "host": ["{{base_url}}"], "path": ["orders", "my"] },
            "description": "Returns all orders placed by the authenticated customer, sorted newest first.\n\n**Auth required:** `customer` role"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n    \"restaurant\": { \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f2\", \"name\": \"Warung Nasi Padang\", \"address\": \"Jl. Thamrin No. 5\" },\n    \"items\": [ { \"name\": \"Nasi Rendang\", \"price\": 35000, \"quantity\": 2 } ],\n    \"status\": \"pending\",\n    \"totalAmount\": 70000,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get Restaurant Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/restaurant/{{restaurant_id}}", "host": ["{{base_url}}"], "path": ["orders", "restaurant", "{{restaurant_id}}"] },
            "description": "Returns all incoming orders for a restaurant, sorted newest first.\n\n**Auth required:** `restaurant_owner` or `admin`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n    \"customer\": { \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f1\", \"name\": \"John Doe\", \"email\": \"john@example.com\", \"phone\": \"081234567890\" },\n    \"items\": [ { \"name\": \"Nasi Rendang\", \"price\": 35000, \"quantity\": 2 } ],\n    \"status\": \"pending\",\n    \"totalAmount\": 70000,\n    \"deliveryAddress\": \"Jl. Gatot Subroto No. 10\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}"] },
            "description": "Returns a single order by ID.\n\n**Auth required:** Any authenticated user. Customers can only see their own orders."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n  \"customer\": { \"name\": \"John Doe\", \"email\": \"john@example.com\" },\n  \"restaurant\": { \"name\": \"Warung Nasi Padang\", \"address\": \"Jl. Thamrin No. 5\" },\n  \"items\": [ { \"name\": \"Nasi Rendang\", \"price\": 35000, \"quantity\": 2 } ],\n  \"status\": \"pending\",\n  \"totalAmount\": 70000,\n  \"deliveryAddress\": \"Jl. Gatot Subroto No. 10\"\n}"
            }
          ]
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/status", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "description": "Advance or cancel an order. Only valid transitions are allowed:\n\n| Current | Allowed next |\n|---|---|\n| `pending` | `confirmed`, `cancelled` |\n| `confirmed` | `preparing`, `cancelled` |\n| `preparing` | `delivering` |\n| `delivering` | `delivered` |\n\n**Auth required:** `restaurant_owner` or `admin`"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n  \"status\": \"confirmed\",\n  \"updatedAt\": \"2024-01-01T00:01:00.000Z\"\n}"
            },
            {
              "name": "400 Invalid transition",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"message\": \"Cannot transition from 'delivered' to 'pending'\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Delivery Tracking",
      "description": "Assign drivers and track deliveries in real-time.\n\n**Role map:**\n- `restaurant_owner` / `admin` — assign a driver to an order\n- `driver` — update location and advance status\n- Any authenticated user — track delivery for an order (customers see only their own)\n\n**Status chain:** `assigned` → `picked_up` → `on_the_way` → `arrived` → `delivered`\n\nWhen status reaches `delivered` the linked Order is automatically updated too.",
      "item": [
        {
          "name": "Assign Delivery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/deliveries", "host": ["{{base_url}}"], "path": ["deliveries"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order\": \"{{order_id}}\",\n  \"driver\": \"<driver_user_id>\",\n  \"estimatedArrival\": \"2024-01-01T12:30:00.000Z\"\n}"
            },
            "description": "Assign a driver to an order and create a delivery record. The order must be in `confirmed` or `preparing` status. Automatically sets the order status to `delivering`.\n\n**Auth required:** `restaurant_owner` or `admin`\n\n**Body fields:**\n| Field | Required | Description |\n|---|---|---|\n| `order` | yes | Order ID to deliver |\n| `driver` | yes | User ID with `driver` role |\n| `estimatedArrival` | no | ISO date string for ETA |"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('delivery_id', data._id);",
                  "    console.log('delivery_id saved:', data._id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f6\",\n  \"order\": {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n    \"deliveryAddress\": \"Jl. Gatot Subroto No. 10, Jakarta\",\n    \"totalAmount\": 70000,\n    \"status\": \"delivering\"\n  },\n  \"driver\": {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f7\",\n    \"name\": \"Budi Santoso\",\n    \"phone\": \"082112345678\"\n  },\n  \"status\": \"assigned\",\n  \"estimatedArrival\": \"2024-01-01T12:30:00.000Z\",\n  \"currentLocation\": null,\n  \"locationHistory\": [],\n  \"createdAt\": \"2024-01-01T12:00:00.000Z\"\n}"
            },
            {
              "name": "400 User is not a driver",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"message\": \"User is not a driver\"\n}"
            },
            {
              "name": "400 Order not in correct state",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"message\": \"Order must be confirmed or preparing before assigning delivery\"\n}"
            },
            {
              "name": "409 Already assigned",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"message\": \"Delivery already assigned for this order\"\n}"
            }
          ]
        },
        {
          "name": "Track Delivery by Order",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/deliveries/order/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["deliveries", "order", "{{order_id}}"]
            },
            "description": "Get the full delivery record for an order — driver info, current GPS location, location history, and status.\n\nThe frontend map component polls this endpoint every 10 seconds.\n\n**Auth required:** Any authenticated user. Customers can only view deliveries for their own orders."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f6\",\n  \"order\": {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n    \"deliveryAddress\": \"Jl. Gatot Subroto No. 10, Jakarta\",\n    \"totalAmount\": 70000,\n    \"status\": \"delivering\",\n    \"customer\": \"64b1c2d3e4f5a6b7c8d9e0f1\"\n  },\n  \"driver\": {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f7\",\n    \"name\": \"Budi Santoso\",\n    \"phone\": \"082112345678\"\n  },\n  \"status\": \"on_the_way\",\n  \"currentLocation\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"address\": \"Jl. Sudirman, Jakarta\",\n    \"timestamp\": \"2024-01-01T12:15:00.000Z\"\n  },\n  \"locationHistory\": [\n    { \"lat\": -6.2100, \"lng\": 106.8400, \"timestamp\": \"2024-01-01T12:10:00.000Z\" },\n    { \"lat\": -6.2088, \"lng\": 106.8456, \"timestamp\": \"2024-01-01T12:15:00.000Z\" }\n  ],\n  \"estimatedArrival\": \"2024-01-01T12:30:00.000Z\",\n  \"pickedUpAt\": \"2024-01-01T12:08:00.000Z\"\n}"
            },
            {
              "name": "404 No delivery found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"message\": \"No delivery found for this order\"\n}"
            },
            {
              "name": "403 Not your order",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"message\": \"Access denied\"\n}"
            }
          ]
        },
        {
          "name": "Get My Deliveries (Driver)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/deliveries/my",
              "host": ["{{base_url}}"],
              "path": ["deliveries", "my"]
            },
            "description": "Returns all deliveries assigned to the authenticated driver, sorted newest first.\n\n**Auth required:** `driver` role"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f6\",\n    \"order\": {\n      \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f4\",\n      \"deliveryAddress\": \"Jl. Gatot Subroto No. 10, Jakarta\",\n      \"totalAmount\": 70000,\n      \"status\": \"delivering\",\n      \"items\": [\n        { \"name\": \"Nasi Rendang\", \"quantity\": 2, \"price\": 35000 }\n      ]\n    },\n    \"status\": \"on_the_way\",\n    \"estimatedArrival\": \"2024-01-01T12:30:00.000Z\",\n    \"createdAt\": \"2024-01-01T12:00:00.000Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Update Driver Location",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/deliveries/{{delivery_id}}/location",
              "host": ["{{base_url}}"],
              "path": ["deliveries", "{{delivery_id}}", "location"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": -6.2088,\n  \"lng\": 106.8456,\n  \"address\": \"Jl. Sudirman, Jakarta\"\n}"
            },
            "description": "Driver pushes their current GPS coordinates. Each update is appended to `locationHistory` so the customer's map shows the full route trail.\n\nCall this every 10–30 seconds from the driver app.\n\n**Auth required:** `driver` role (must be the assigned driver for this delivery)\n\n**Body fields:**\n| Field | Required | Description |\n|---|---|---|\n| `lat` | yes | Latitude (decimal degrees) |\n| `lng` | yes | Longitude (decimal degrees) |\n| `address` | no | Human-readable street address |"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"deliveryId\": \"64b1c2d3e4f5a6b7c8d9e0f6\",\n  \"currentLocation\": {\n    \"lat\": -6.2088,\n    \"lng\": 106.8456,\n    \"address\": \"Jl. Sudirman, Jakarta\",\n    \"timestamp\": \"2024-01-01T12:15:00.000Z\"\n  },\n  \"status\": \"on_the_way\"\n}"
            },
            {
              "name": "400 Delivery already completed",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"message\": \"Delivery is already completed\"\n}"
            },
            {
              "name": "403 Not assigned driver",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"message\": \"Access denied\"\n}"
            }
          ]
        },
        {
          "name": "Update Delivery Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/deliveries/{{delivery_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["deliveries", "{{delivery_id}}", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"picked_up\"\n}"
            },
            "description": "Advance the delivery to the next status. Only valid forward transitions are accepted.\n\nWhen status becomes `delivered`, the linked Order is automatically updated to `delivered` as well.\n\n**Auth required:** `driver` (assigned driver) or `admin`\n\n**Valid transitions:**\n| Current status | Allowed next |\n|---|---|\n| `assigned` | `picked_up` |\n| `picked_up` | `on_the_way` |\n| `on_the_way` | `arrived` |\n| `arrived` | `delivered` |\n\n**Timestamps set automatically:**\n- `pickedUpAt` — when status → `picked_up`\n- `deliveredAt` — when status → `delivered`"
          },
          "response": [
            {
              "name": "200 OK — picked_up",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f6\",\n  \"status\": \"picked_up\",\n  \"pickedUpAt\": \"2024-01-01T12:08:00.000Z\",\n  \"updatedAt\": \"2024-01-01T12:08:00.000Z\"\n}"
            },
            {
              "name": "200 OK — delivered",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f6\",\n  \"status\": \"delivered\",\n  \"pickedUpAt\": \"2024-01-01T12:08:00.000Z\",\n  \"deliveredAt\": \"2024-01-01T12:28:00.000Z\",\n  \"updatedAt\": \"2024-01-01T12:28:00.000Z\"\n}"
            },
            {
              "name": "400 Invalid transition",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"message\": \"Cannot transition from 'assigned' to 'delivered'\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Logs",
      "description": "API access logs — **admin only**.\n\nEvery request is stored in MongoDB with method, path, status code, response time, IP, and user identity. Logs auto-delete after 30 days.\n\n**Auth required:** `admin` role for all endpoints.",
      "item": [
        {
          "name": "Get Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/logs?page=1&limit=50",
              "host": ["{{base_url}}"],
              "path": ["logs"],
              "query": [
                { "key": "page",       "value": "1",    "description": "Page number (default: 1)" },
                { "key": "limit",      "value": "50",   "description": "Results per page (default: 50)" },
                { "key": "userId",     "value": "",     "description": "Filter by user ObjectId", "disabled": true },
                { "key": "method",     "value": "",     "description": "Filter by HTTP method: GET, POST, PATCH, DELETE", "disabled": true },
                { "key": "path",       "value": "",     "description": "Filter by path substring (case-insensitive regex)", "disabled": true },
                { "key": "statusCode", "value": "",     "description": "Filter by exact HTTP status code e.g. 401", "disabled": true },
                { "key": "from",       "value": "",     "description": "Start of date range (ISO 8601) e.g. 2024-01-01T00:00:00Z", "disabled": true },
                { "key": "to",         "value": "",     "description": "End of date range (ISO 8601)", "disabled": true }
              ]
            },
            "description": "Paginated list of all API request logs. Use query params to filter.\n\n**Auth required:** `admin`\n\n**Example queries:**\n```\nGET /api/logs?statusCode=401                        # all failed auth attempts\nGET /api/logs?method=POST&path=orders               # all order creation calls\nGET /api/logs?userId=64b1c2...&from=2024-01-01      # one user's activity\nGET /api/logs?page=2&limit=20                       # pagination\n```"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"total\": 1240,\n  \"page\": 1,\n  \"pages\": 25,\n  \"logs\": [\n    {\n      \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f9\",\n      \"method\": \"POST\",\n      \"path\": \"/auth/login\",\n      \"statusCode\": 200,\n      \"responseTime\": 143,\n      \"ip\": \"::1\",\n      \"userAgent\": \"PostmanRuntime/7.32.3\",\n      \"userId\": {\n        \"_id\": \"64b1c2d3e4f5a6b7c8d9e0f1\",\n        \"name\": \"John Doe\",\n        \"email\": \"john@example.com\",\n        \"role\": \"customer\"\n      },\n      \"userEmail\": \"john@example.com\",\n      \"userRole\": \"customer\",\n      \"createdAt\": \"2024-01-01T12:00:00.000Z\"\n    },\n    {\n      \"_id\": \"64b1c2d3e4f5a6b7c8d9e0fa\",\n      \"method\": \"POST\",\n      \"path\": \"/auth/login\",\n      \"statusCode\": 401,\n      \"responseTime\": 89,\n      \"ip\": \"203.0.113.42\",\n      \"userAgent\": \"Mozilla/5.0\",\n      \"userId\": null,\n      \"userEmail\": null,\n      \"userRole\": null,\n      \"createdAt\": \"2024-01-01T11:58:00.000Z\"\n    }\n  ]\n}"
            },
            {
              "name": "403 Not admin",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"message\": \"Access denied\"\n}"
            }
          ]
        },
        {
          "name": "Get Log Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/logs/stats",
              "host": ["{{base_url}}"],
              "path": ["logs", "stats"]
            },
            "description": "Returns three aggregated summaries in one call:\n\n- **`topRoutes`** — top 10 most-called endpoints with call count and average response time\n- **`topUsers`** — top 10 most active authenticated users by request count\n- **`statusBreakdown`** — count of every HTTP status code (200, 201, 400, 401, 404, 500…)\n\n**Auth required:** `admin`"
